{
  "name": "Vidonex Development Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "pnpmVersion": "latest"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg build-essential libgtk-3-dev libwebkit2gtk-4.1-dev && go install github.com/wailsapp/wails/v2/cmd/wails@latest && go mod download",
  "customizations": {
    "vscode": {
      "settings": {
        "go.useLanguageServer": true,
        "go.lintTool": "golangci-lint",
        "go.lintOnSave": "package",
        "editor.formatOnSave": true
      },
      "extensions": [
        "golang.go",
        "Vue.volar",
        "bradlc.vscode-tailwindcss",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "forwardPorts": [8080, 3000]
}
